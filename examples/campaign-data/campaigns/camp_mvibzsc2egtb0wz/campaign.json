  "entityGroups": [],
  "contentModules": [
    {
      "id": "beat_mvibzsc5tto1clb",
      "type": "beat",
      "name": "Robbery near the fountain",
      "text": "A pickpocket strikes if the party lingers near the central fountain for more than a minute. [[SAY:npc_mvibzsc458ipru4]]Watch your pockets around here.[[/SAY]] the grey man mutters, if he's still nearby.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "mod_mvibzsc6kep9opi",
      "type": "description",
      "name": "You arrive at the Rusted spire market as…",
      "html": "You arrive at the Rusted spire market as the twin suns crest the horizon. Stalls are still shuttered, but a [[npc_mvibzsc458ipru4]] leans against a support strut near the old [[loc_mvibzsc47cuczid]], watching the crowd trickle in. [[SAY:npc_mvibzsc458ipru4]]You are early.[[/SAY]] he mutters, not looking up.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "mod_mvibzsc6bm7hpne",
      "type": "description",
      "name": "Rain streaks down the market's plastic a…",
      "html": "Rain streaks down the market's plastic awnings. The stalls near the [[loc_mvibzsc47cuczid]] are busier than usual — the [[npc_mvibzsc458ipru4]] is nowhere in sight.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5u977hhb",
      "type": "note",
      "name": "Built into the ribs of a downed orbital …",
      "text": "Built into the ribs of a downed orbital tether. The structure groans audibly in high wind — a good excuse for a Perception check to notice anything else moving.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc50qke8pj",
      "type": "topic",
      "name": "If asked about the tether wreck",
      "text": "Locals treat it as sacred ground. Climbing on the exposed rib sections is technically forbidden, though nobody enforces it seriously.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5nz7uonb",
      "type": "note",
      "name": "Former signal corps engineer. Left hand …",
      "text": "Former signal corps engineer. Left hand replaced with a salvaged manipulator arm. Deeply distrustful of Concord officials.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5c6sllcd",
      "type": "note",
      "name": "Waiting for a courier who never shows. A…",
      "text": "Waiting for a courier who never shows. Approaches the party if they linger near the scrap gate for more than a minute.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5kctcgmk",
      "type": "note",
      "name": "Keeps glancing toward the fuel barge — h…",
      "text": "Keeps glancing toward the fuel barge — he already knows the sailor is avoiding him.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5pczjmmx",
      "type": "note",
      "name": "Not present today. Last seen heading tow…",
      "text": "Not present today. Last seen heading toward the relay outpost before sunrise.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc590krx71",
      "type": "topic",
      "name": "Ask about the signal",
      "text": "He goes quiet, then mutters about a repeating pattern coming from the outpost. Wants medical supplies in trade for the details.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc57sswer9",
      "type": "topic",
      "name": "Rumors in town",
      "text": "A Concord patrol passed through three days ago, asking after outsiders. The stall keeper at the scrap gate is hiding something in the back room.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5sqdtj8t",
      "type": "topic",
      "name": "What happened with the sailor",
      "text": "If pressed, he admits the debt was never really about money — the sailor lost cargo that belonged to someone the grey man still answers to.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z",
      "questId": "quest_mvibzsc6hzmn1f8",
      "questIndex": 2
    },
    {
      "id": "blk_mvibzsc5gsl7ugf",
      "type": "note",
      "name": "A faint hum is audible up close. It is t…",
      "text": "A faint hum is audible up close. [[DCCHECK:dcc_mvibzsc5me5inlb]] [[IF:cnd_mvibzsc56t6ayb:success,critSuccess]]It is the same repeating pattern the grey man talks about, coming from the relay outpost.[[/IF]]",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5a5g5ljw",
      "type": "note",
      "name": "Still chained shut. Opens automatically …",
      "text": "Still chained shut. Opens automatically at midday.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc541ak7gy",
      "type": "note",
      "name": "Propped open with a supply crate; foot t…",
      "text": "Propped open with a supply crate; foot traffic is heavier than usual.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5b8fhl6v",
      "type": "note",
      "name": "Runs the fuel barge at the eastern dock.…",
      "text": "Runs the fuel barge at the eastern dock. Owes the grey man a debt he refuses to discuss.",
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z"
    },
    {
      "id": "blk_mvibzsc5jr9e1lp",
      "type": "scene",
      "name": "The grey man collects on an old debt",
      "lines": [
        {
          "id": "line_mvibzsc5208r5sa",
          "speakerId": null,
          "text": "The old sailor freezes mid-stride as the grey man steps out from behind a stall."
        },
        {
          "id": "line_mvibzsc5bzw6vow",
          "speakerId": "npc_mvibzsc458ipru4",
          "text": "You have been avoiding the dock road for a week."
        },
        {
          "id": "line_mvibzsc55ntw18s",
          "speakerId": "npc_mvibzsc5wkn6oh6",
          "text": "I do not have it yet. Another few days."
        },
        {
          "id": "line_mvibzsc6qwtxpxo",
          "speakerId": "npc_mvibzsc458ipru4",
          "text": "Three more days. Then I stop asking politely."
        }
      ],
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.157Z",
      "questId": "quest_mvibzsc6hzmn1f8",
      "questIndex": 1
    },
    {
      "id": "blk_mvibzsc6mxxar7h",
      "type": "scene",
      "name": "Settling the debt",
      "lines": [
        {
          "id": "line_mvibzsc6hyhwqby",
          "speakerId": "npc_mvibzsc5wkn6oh6",
          "text": "The cargo is gone. All I can offer is a seat on the next barge out."
        },
        {
          "id": "line_mvibzsc6tnxqn8g",
          "speakerId": "npc_mvibzsc458ipru4",
          "text": "Then we are square. For now."
        }
      ],
      "complete": false,
      "createdAt": "2026-10-21T16:33:19.158Z",
      "questId": "quest_mvibzsc6hzmn1f8",
      "questIndex": 3
    }
  ],
